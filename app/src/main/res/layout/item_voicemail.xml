<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a per-day group cell, exactly like item_call_log.xml: the adapter
     sets a position-aware background (rounded top/bottom of the group) so
     each day reads as one card, matching the real call log's own style. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:orientation="vertical"
    android:background="@drawable/bg_log_group_single">

    <!-- Inset split between rows of the same day (hidden on the first row). -->
    <View
        android:id="@+id/rowDivider"
        style="@style/LogRowDivider"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/vmRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <View
            android:id="@+id/vmUnread"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_record_dot"
            android:visibility="gone"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp">

            <TextView
                android:id="@+id/avatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_solid"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="J"
                tools:visibility="visible" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatarPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/CircleImageView" />

            <ImageView
                android:id="@+id/selectedCheck"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_solid"
                android:backgroundTint="?attr/colorPrimary"
                android:padding="10dp"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                tools:text="845-351-1200" />

            <TextView
                android:id="@+id/vmSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="0:42 • 3:45 PM" />
        </LinearLayout>
    </LinearLayout>

    <!-- Expanded shade: seek/time first, then the play pill + secondary icon
         controls on one line below it (doesn't auto-play), then Call/Message/
         Block rows matching the call log's own message/history shade
         buttons. -->
    <LinearLayout
        android:id="@+id/vmExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <SeekBar
            android:id="@+id/vmSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vmElapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="0:07" />

            <TextView
                android:id="@+id/vmTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="0:42" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vmPlayPill"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/vvm_play"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:cornerRadius="22dp" />

            <ImageView
                android:id="@+id/vmSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/vvm_speaker"
                android:padding="8dp"
                android:src="@drawable/ic_speaker"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/vmShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/vvm_share"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/vmDownload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/vvm_download"
                android:padding="8dp"
                android:src="@drawable/ic_download"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/vmDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/vvm_delete"
                android:padding="8dp"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vmActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vmActionCall"
                style="@style/LogShadeButton"
                android:drawableStart="@drawable/ic_call_outline"
                android:text="@string/vvm_action_call" />

            <TextView
                android:id="@+id/vmActionMessage"
                style="@style/LogShadeButton"
                android:drawableStart="@drawable/ic_message"
                android:text="@string/log_message" />

            <TextView
                android:id="@+id/vmActionBlock"
                style="@style/LogShadeButton"
                android:drawableStart="@drawable/ic_block"
                android:text="@string/block_number" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
